+      const candidatos = nomes
+        .filter((n) => n.id !== d.id && n.alfa.length && n.alfa.every((a) => texto.includes(` ${a} `) || texto.includes(a)))
+        .map((n) => ({ id: n.id, completo: n.num.every((x) => texto.includes(x)) }));
