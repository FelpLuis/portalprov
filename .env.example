# /etc/portal-noc.env — variáveis do Portal NOC (systemd EnvironmentFile)
HOST=127.0.0.1
PORT=8790
# Endereço público do portal (aparece nas integrações)
PORTAL_URL=https://portal.updown.com.br
# Cookie válido em todos os subdomínios/portas: é o que faz o login único funcionar
COOKIE_DOMAIN=.updown.com.br
COOKIE_SECURE=auto
SESSION_HORAS=12
LEMBRAR_DIAS=30
DATA_DIR=/var/lib/portal-noc
