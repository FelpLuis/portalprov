# Alternativa ao Caddy: portal atrás do nginx (certificado com certbot).
server {
    listen 443 ssl http2;
    server_name portal.updown.com.br;
    ssl_certificate     /etc/letsencrypt/live/portal.updown.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal.updown.com.br/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8790;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
server {
    listen 80;
    server_name portal.updown.com.br;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}
